# Copy to .env.local and fill in.
# Local dev (Homebrew Postgres):
DATABASE_URL=postgres://localhost/deal_finder

# Supabase (Project Settings -> Database -> Connection string -> URI).
# Use the pooled connection (port 6543) for serverless/Vercel:
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Auth (Clerk). Without these the app still runs — sign-in is simply off
# (see isAuthConfigured in src/lib/auth.ts). Google + email are enabled in the
# Clerk dashboard, not in code. Use pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Notifications (docs/NOTIFICATIONS.md) ─────────────────────────────
# Everything below is optional. With none of it set the worker still runs and
# reports what it *would* have sent, which is how to test it safely.

# Master switch. Leave unset/false until a provider below is verified —
# otherwise the first cron run mails real users.
NOTIFICATIONS_ENABLED=false

# Protects /api/cron/notifications. Vercel sends it as `Authorization: Bearer`
# on every cron invocation once the variable exists on the project. Required in
# production: without it the route refuses to run.
CRON_SECRET=

# Email — Resend. NOTIFY_EMAIL_FROM must be on a domain verified in Resend, or
# every send fails with a 403.
RESEND_API_KEY=re_...
NOTIFY_EMAIL_FROM="קרקעHOT <alerts@karkahot.co.il>"
NOTIFY_EMAIL_REPLY_TO=

# WhatsApp — pick one provider (or leave unset to disable the channel).
#   twilio = official Business API. Alerts start conversations, so Meta
#            requires an approved template: set TWILIO_WHATSAPP_CONTENT_SID or
#            messages only reach the sandbox / the 24h reply window.
#   green  = Green API, drives a real WhatsApp account. No template approval,
#            unofficial — good for staging, weigh it before production.
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+972...
TWILIO_WHATSAPP_CONTENT_SID=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_URL=https://api.green-api.com

# Links inside messages. Falls back to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=https://deal-finder-il.vercel.app

# Worker tuning — defaults in src/lib/notifications/config.ts.
# NOTIFY_INSTANT_LOOKBACK_HOURS=26   how far back an instant run looks
# NOTIFY_DIGEST_LOOKBACK_HOURS=72    wider, so a missed day still lands
# NOTIFY_FREE_DELAY_HOURS=24         the free tier's delay (the upgrade lever)
# NOTIFY_MAX_ITEMS_PER_MESSAGE=5
# NOTIFY_MAX_SENDS_PER_RUN=200       safety cap per invocation
# NOTIFY_MAX_ATTEMPTS=3              retries of a failed delivery
# Who is PRO is not configured here at all: it is user_contacts.tier, set
# from the admin dashboard (/admin). See docs/ADMIN.md.

# Operational alerts — "the pipeline broke", not "here is a tender". Separate
# from user contacts on purpose: an ops channel must not disappear because
# someone unsubscribed. Posted by CI to /api/ops/alert using CRON_SECRET, so
# the Green API credentials stay in one place instead of being copied into
# GitHub as well.
OPS_ALERT_PHONE=+9725...
OPS_ALERT_EMAIL=
# At most one message per kind per this many hours. The pipeline runs hourly;
# without a gap a persistent fault sends 24 identical messages a day, which is
# how an alert channel gets muted.
OPS_ALERT_MIN_GAP_HOURS=6

# ── Admin dashboard (/admin) ──────────────────────────────────────────
# Comma-separated Clerk user ids allowed to open the dashboard, set someone's
# plan and read other people's contact details. Checked on the server on every
# entry point. Unset in production = nobody gets in (the route 404s); unset in
# local development = open, so the page can be worked on without Clerk.
ADMIN_USER_IDS=
