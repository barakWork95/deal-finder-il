# Copy to .env.local and fill in.
# Local dev (Homebrew Postgres):
DATABASE_URL=postgres://localhost/deal_finder

# Supabase (Project Settings -> Database -> Connection string -> URI).
# Use the pooled connection (port 6543) for serverless/Vercel:
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Auth (Clerk) — optional until authentication is switched on.
# Google + email sign-in are enabled in the Clerk dashboard, not in code.
# See src/components/AuthProvider.tsx for the switch-on steps.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
